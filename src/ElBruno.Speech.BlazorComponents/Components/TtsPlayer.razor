@namespace ElBruno.Speech.BlazorComponents
<div class="tts-player">
    <button @onclick="Play" disabled="@(!CanPlay)">&#9654; Play</button>
    <button @onclick="Pause" disabled="@(!IsPlaying)">&#9646;&#9646; Pause</button>
    <button @onclick="Stop" disabled="@(!IsPlaying && !IsPaused)">&#9632; Stop</button>
    <input type="range" min="0" max="100" @bind="Volume" />
    @if (ShowVolumeLabel) { <span>@Volume%</span> }
</div>

@code {
    [Parameter] public bool AutoPlay { get; set; }
    [Parameter] public bool ShowVolumeLabel { get; set; } = true;
    [Parameter] public EventCallback OnPlayRequested { get; set; }
    [Parameter] public EventCallback OnPauseRequested { get; set; }
    [Parameter] public EventCallback OnStopRequested { get; set; }
    [Parameter] public EventCallback OnPlaybackCompleted { get; set; }

    public bool IsPlaying { get; private set; }
    public bool IsPaused { get; private set; }
    public int Volume { get; set; } = 80;
    private bool CanPlay => !IsPlaying;
    private bool _autoPlayHandled;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && AutoPlay && !_autoPlayHandled)
        {
            _autoPlayHandled = true;
            await Play();
        }
    }

    public async Task Play()
    {
        IsPlaying = true;
        IsPaused = false;
        await OnPlayRequested.InvokeAsync();
        await InvokeAsync(StateHasChanged);
    }

    public async Task Pause()
    {
        if (!IsPlaying)
            return;

        IsPlaying = false;
        IsPaused = true;
        await OnPauseRequested.InvokeAsync();
        await InvokeAsync(StateHasChanged);
    }

    public async Task Stop()
    {
        if (!IsPlaying && !IsPaused)
            return;

        IsPlaying = false;
        IsPaused = false;
        await OnStopRequested.InvokeAsync();
        await OnPlaybackCompleted.InvokeAsync();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Signals completion after the host's audio output finishes.</summary>
    public async Task CompletePlayback()
    {
        IsPlaying = false;
        IsPaused = false;
        await OnPlaybackCompleted.InvokeAsync();
        await InvokeAsync(StateHasChanged);
    }
}
