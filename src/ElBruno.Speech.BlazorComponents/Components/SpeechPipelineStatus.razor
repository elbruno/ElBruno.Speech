@namespace ElBruno.Speech.BlazorComponents
@implements IDisposable
@inject SpeechStateService State
<div class="speech-pipeline-status">
    <span class="badge @GetBadgeClass()">@EffectiveState</span>
    @if (ShowStateLabel) { <span class="state-label">@EffectiveState</span> }
</div>

@code {
    [Parameter] public PipelineState CurrentState { get; set; }
    [Parameter] public bool ShowStateLabel { get; set; } = true;
    [Parameter] public EventCallback<PipelineState> OnStateChanged { get; set; }
    private bool _currentStateProvided;

    private PipelineState EffectiveState => _currentStateProvided ? CurrentState : State.CurrentState;

    public override Task SetParametersAsync(ParameterView parameters)
    {
        _currentStateProvided = parameters.TryGetValue(nameof(CurrentState), out PipelineState _);
        return base.SetParametersAsync(parameters);
    }

    protected override void OnInitialized() => State.Changed += HandleStateChanged;

    protected override void OnParametersSet()
    {
        if (_currentStateProvided)
            State.SetState(CurrentState);
    }

    private string GetBadgeClass() => EffectiveState switch {
        PipelineState.Listening => "badge-success",
        PipelineState.Transcribing => "badge-warning",
        PipelineState.Responding => "badge-info",
        PipelineState.Speaking => "badge-primary",
        _ => "badge-secondary"
    };

    private async void HandleStateChanged(object? sender, EventArgs args)
    {
        await InvokeAsync(async () =>
        {
            await OnStateChanged.InvokeAsync(State.CurrentState);
            StateHasChanged();
        });
    }

    public void Dispose() => State.Changed -= HandleStateChanged;
}
