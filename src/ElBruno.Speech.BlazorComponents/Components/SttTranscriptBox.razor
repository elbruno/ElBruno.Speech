@namespace ElBruno.Speech.BlazorComponents
@implements IDisposable
@inject SpeechStateService State
<div class="stt-transcript-box">
    @foreach (var seg in State.Transcript.TakeLast(Math.Max(0, MaxSegments))) {
        <div class="segment @(seg.IsFinal ? "final" : "interim")">
            @if (ShowTimestamps) { <span class="timestamp">[@seg.Timestamp.ToString("HH:mm:ss")]</span> }
            <span class="text">@seg.Text</span>
        </div>
    }
</div>

@code {
    [Parameter] public int MaxSegments { get; set; } = 20;
    [Parameter] public bool ShowTimestamps { get; set; } = true;

    protected override void OnInitialized() => State.Changed += HandleStateChanged;

    public void AddSegment(string text, bool isFinal = true) => State.AddTranscript(text, isFinal);

    public void Clear() => State.ClearTranscript();

    private void HandleStateChanged(object? sender, EventArgs args) => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= HandleStateChanged;
}
