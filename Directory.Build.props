<Project>

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <!-- On machines with only .NET 8 SDK, limit to net8.0 for local builds -->
    <TargetFrameworks Condition="'$(NETCoreSdkVersion)' != '' AND $([System.Version]::Parse('$(NETCoreSdkVersion)').Major) &lt; 9">net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IncludeSpeechFixtures Condition="'$(IncludeSpeechFixtures)' == '' AND '$(GITHUB_ACTIONS)' == 'true'">false</IncludeSpeechFixtures>
    <IncludeSpeechFixtures Condition="'$(IncludeSpeechFixtures)' == ''">true</IncludeSpeechFixtures>
    <!-- MEAI speech/TTS APIs are experimental by design — suppress until stable -->
    <!-- CS1591: enforce XML docs per-package when implementing, not at scaffold stage -->
    <!-- NU5118: README.md duplicate — SDK auto-includes for some TFMs, our explicit include is deduped safely -->
    <NoWarn>$(NoWarn);MEAI001;CS1591;NU5118</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Package icon -->
    <PackageIcon>logo.png</PackageIcon>

    <!-- Version — override at publish time with /p:Version=X.Y.Z -->
    <Version>1.0.0</Version>
    <PackageReleaseNotes Condition="'$(Version)' == '1.6.0-preview.1'">Experimental opt-in Parakeet TDT v3 local multilingual STT provider, pinned integrity-checked ONNX model bundle, native token-start metadata, and file-transcription sample. Whisper defaults unchanged. Word/segment intervals and language ID are unavailable. Podcast accuracy comparison remains pending.</PackageReleaseNotes>
    <PackageReleaseNotes Condition="'$(Version)' == '1.6.0-preview.2'">Adds an opt-in local Whisper large-v3 CPU STT provider alongside the existing opt-in Parakeet provider. Existing Whisper and pipeline defaults are unchanged. Includes local-only FLEURS comparison evidence; no reviewed word timestamps or podcast accuracy claim. Whisper weights are not bundled; native runtime and model licensing/requirements apply.</PackageReleaseNotes>
    <PackageReleaseNotes Condition="'$(Version)' == '1.6.0-preview.3'">Adds the opt-in Ollama Phonon ITextToSpeechClient provider with WAV/PCM, incremental streaming, cancellation, HTTP error reporting, and a runnable C# sample. Ollama speech currently requires an Apple Silicon Mac with MLX; Windows/Linux support is pending upstream. Synthetic provider/sample checks pass on .NET 8/10; live Phonon generation and listening verification remain pending. Pipeline defaults are unchanged. No model weights are bundled.</PackageReleaseNotes>

    <!-- Package metadata -->
    <Authors>Bruno Capuano</Authors>
    <Company>ElBruno</Company>
    <PackageProjectUrl>https://github.com/elbruno/ElBruno.Speech</PackageProjectUrl>
    <RepositoryUrl>https://github.com/elbruno/ElBruno.Speech</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright © Bruno Capuano</Copyright>

    <!-- Source Link and symbols -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Deterministic builds -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- Include root README.md and logo in every NuGet package -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)assets\logo.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- Source Link for GitHub -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
</Project>
